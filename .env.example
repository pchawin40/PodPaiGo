# Browser key used only by client-side Google Maps UI, including the parking map modal.
# Set NEXT_PUBLIC_GOOGLE_MAPS_API_KEY in Vercel Production/Preview and redeploy after changes.
# The key must have Maps JavaScript API enabled and HTTP referrers that include:
# - https://podpaigo.com/*
# - https://www.podpaigo.com/*
# - http://localhost:3000/*
# - http://127.0.0.1:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Maps Map ID for styled/vector maps.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-side Google key for Places/Geocoding/Routes. Keep separate from the public browser key.
GOOGLE_MAPS_SERVER_API_KEY=
TRAFFIC_PROVIDER =
# Optional: Google Routes request timeout in ms before backup routing starts (default 4000).
GOOGLE_ROUTE_TIMEOUT_MS =
# Backup route-timing provider (server-side only; never exposed to the client).
# Used only when Google Routes fails/times out/is budget-blocked/disabled, for the
# main trip route (not per parking candidate). Google Maps stays the user-facing
# "Open directions" link. Leave blank to disable Mapbox (skips straight to the
# straight-line coordinate fallback).
MAPBOX_ACCESS_TOKEN =
# Optional: Mapbox Directions request timeout in ms (default 5000).
MAPBOX_ROUTE_TIMEOUT_MS =
LOCAL_DATABASE_URL=
DATABASE_URL =
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used for Supabase OAuth redirects (local dev example below)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL =
DEBUG_LOGS =
# Internal UI diagnostics (never enable in production for normal users)
# NEXT_PUBLIC_DEBUG_UI=true
# Comma-separated admin emails for account admin tools
ADMIN_EMAILS=pathocha000@gmail.com
# Server-side beta feedback email notifications via Resend
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=
PARKING_REFRESH_SECRET=
PARKING_SEARCH_RADIUS_METERS =
PARKING_DISCOVERY_PROVIDER=all
# Recommended for Vercel Preview: live parking can take ~13s, so keep this bounded at 15s.
PARKING_FETCH_TIMEOUT_MS=15000
PARKING_DB_READ_TIMEOUT_MS=4000
PARKWHIZ_CACHE_READ_TIMEOUT_MS=4000
PARKWHIZ_CACHE_SAVE_TIMEOUT_MS=4000
PARKING_PRICE_SNAPSHOT_READ_TIMEOUT_MS=4000
PARKING_PRICE_SNAPSHOT_SAVE_TIMEOUT_MS=4000
DISABLE_PARKING_DB_CACHE=false
PARKING_INITIAL_LIVE_ROUTE_LIMIT=3
# Google API quota controls
DISABLE_GOOGLE_ROUTES=false
DISABLE_GOOGLE_PLACES=true
DISABLE_GOOGLE_PLACE_PHOTOS=true
DISABLE_GOOGLE_PLACE_REVIEWS=true
DISABLE_GOOGLE_PARKING_DISCOVERY=true
DISABLE_GEOCODING=false
GOOGLE_ROUTES_DAILY_LIMIT=100
GOOGLE_PLACES_DAILY_LIMIT=100
GEOCODING_DAILY_LIMIT=50
MAX_GOOGLE_ROUTE_CALLS_PER_SEARCH=3
MAX_LIVE_QUOTES_PER_SEARCH=3
MAX_GOOGLE_PLACES_CALLS_PER_REQUEST=0
MAX_GOOGLE_PLACE_DETAILS_PER_REQUEST=0
MAX_GOOGLE_SEARCHTEXT_PER_REQUEST=0
MAX_GOOGLE_PHOTO_MEDIA_PER_REQUEST=0
MAX_GOOGLE_PLACE_REVIEWS_PER_REQUEST=0
LIVE_ROUTE_CACHE_TTL_MINUTES=30
PLACES_SEARCH_QUERY_CACHE_TTL_HOURS=24
PLACE_PHOTO_MEDIA_CACHE_TTL_HOURS=24
GOOGLE_PLACES_CACHE_WRITE_TIMEOUT_MS=10000
# AI trip assistant (mock by default in development)
DISABLE_AI_ASSISTANT=false
AI_ASSISTANT_PROVIDER=mock
MAX_AI_PARSE_CALLS_PER_REQUEST=1
MAX_AI_PARSE_CALLS_PER_USER_DAY=20
MAX_AI_PARSE_CALLS_PER_ANON_DAY=5
MAX_AI_PARSE_INPUT_CHARS=1000
# OPENAI_API_KEY=
# OPENAI_TRIP_PARSE_MODEL=gpt-4o-mini
# Gradual backfill for snapshot rows missing lat/lng (manual only — never auto-run)
BACKFILL_DRY_RUN=true
BACKFILL_PLACE_SNAPSHOT_LIMIT=20
# GOOGLE_PARKING_MAX_RESULTS=50 caps Google Places parking options returned per airport search.
# NEXT_PUBLIC_PARKING_MAP_MAX_LOTS=50 caps parking lots rendered on the results map modal.
# NEXT_PUBLIC_PODPAIGO_DEBUG=1 is deprecated; use NEXT_PUBLIC_DEBUG_UI=true instead.
# SEA_CURATED_ACCESS=1 enables SEA hidden access options like Northgate Park + Link.
# Restart dev server after changing .env.local.
# Supabase Auth OAuth setup: see docs/supabase-oauth-setup.md
SEA_CURATED_ACCESS=1

# --- Parking provider outbound affiliate/referral attribution (optional) ---
# If unset, original provider booking URLs are preserved.
# PARKWHIZ_AFFILIATE_ID=
# PARKWHIZ_AFFILIATE_PARAM=
# PARKWHIZ_SUB_ID_PARAM=
# APR_AFFILIATE_ID=
# APR_AFFILIATE_PARAM=
# APR_SUB_ID_PARAM=
# SPOTHERO_AFFILIATE_ID=
# SPOTHERO_AFFILIATE_PARAM=
# SPOTHERO_SUB_ID_PARAM=
# PODPAIGO_OUTBOUND_SUBID_PARAM=
# PODPAIGO_UTM_SOURCE=podpaigo
# PODPAIGO_UTM_MEDIUM=referral
# PODPAIGO_UTM_CAMPAIGN=parking

# --- Provider activation (Phase 3.1) ---
# Set DISABLE_PARKING_DB_CACHE=false once DATABASE_URL is configured.
# GOOGLE_MAPS_SERVER_API_KEY unlocks Google Places discovery provider.
# Populate inventory: POST /api/parking/discover {"airportCode":"SEA"}
# Refresh APR cache (SEA only): GET /api/admin/refresh-apr?checkInDate=&checkOutDate=
# Diagnostics page: /admin/parking-diagnostics
# Coverage audit: npm run audit:parking-coverage
