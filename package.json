{
  "name": "podpaigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "import:airports": "node scripts/generate-airports-json.mjs",
    "import:airports:db": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/import-us-airports.ts",
    "audit:parking-coverage": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/audit-parking-coverage.ts",
    "backfill:place-snapshot-coords": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/backfill-place-snapshot-coords.ts",
    "seed:parking-lot-photos": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-parking-lot-photos.ts",
    "activate:parking-providers": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/activate-parking-providers.ts",
    "lint": "eslint",
    "lint:watch": "nodemon --watch app --watch lib --ext ts,tsx --exec \"npm run lint\"",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/check-db-connection.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "claude": "^0.1.2",
    "codex": "^0.2.3",
    "dotenv": "^17.4.2",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "psql": "^0.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rg": "^0.0.2",
    "vercel": "^54.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.64.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
